# LLM provider: groq | openai | rules
LLM_PROVIDER=groq

# Groq (free tier) - https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# OpenAI (optional alternative - set LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Behaviour
LLM_TIMEOUT_MS=6000
MOCK_LATENCY_MS=250
NEXT_PUBLIC_APP_NAME=Rasta
